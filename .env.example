# ==========================================
# CONFIGURAÇÕES DA PLATAFORMA SOCIAL CRM & AI
# ==========================================

# Copie este arquivo para backend/.env (o backend roda com a pasta backend como diretório atual)

# Projeto & API
PROJECT_NAME="Plataforma Omnichannel Social CRM & AI"
API_V1_STR="/api/v1"
SECRET_KEY="sua_chave_secreta_aqui_troque_em_producao"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Google Gemini API
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Evolution API v2 (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="CRM_EVOLUTION_SECRET_KEY_2026"
EVOLUTION_INSTANCE_NAME="cras-anapolis"

# Meta Cloud API (Opcional)
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WEBHOOK_VERIFY_TOKEN="meta_cras_webhook_secret_2026"

# Banco de Dados & Cache (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=crm_social_db
# Deixe vazio para usar um SQLite local (backend/triagens_dev.db) sem Docker
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5433/crm_social_db
REDIS_URL=redis://:redis123@localhost:6379/0

# Criptografia de Dados (LGPD)
ENCRYPTION_SECRET_KEY="sua_chave_fernet_aes_256_base64"

# LGPD e conversa
RETENCAO_DIAS=180
CONVERSA_EXPIRA_MIN=120
