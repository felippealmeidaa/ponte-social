# ==========================================
# CONFIGURAÇÕES DA PLATAFORMA SOCIAL CRM & AI
# ==========================================
# Copie este arquivo para backend/.env e preencha os valores.
# O .env está no .gitignore: NUNCA faça commit dele nem cole chaves reais aqui.
#
# Para gerar segredos aleatórios:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Projeto & API
PROJECT_NAME="Plataforma Omnichannel Social CRM & AI"
API_V1_STR="/api/v1"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT (obrigatório fora de development; em development, vazio = chave temporária)
SECRET_KEY=
ALGORITHM=HS256

# Criptografia de Dados (LGPD) - obrigatório fora de development
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET_KEY=

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Evolution API v2 (WhatsApp) - a mesma chave é usada pelo backend e pelo container
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=cras-anapolis

# Meta Cloud API (Opcional)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Banco de Dados & Cache (Docker) - usados pelo docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=crm_social_db
POSTGRES_PORT=5433
REDIS_PASSWORD=
REDIS_PORT=6379
# Deixe DATABASE_URL vazio para usar um SQLite local (backend/triagens_dev.db) sem Docker.
# Com Docker: postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@localhost:5433/crm_social_db
DATABASE_URL=
REDIS_URL=

# LGPD e conversa
RETENCAO_DIAS=180
CONVERSA_EXPIRA_MIN=120

# Protótipos da fase 2 (Flow Builder, AI Gateway, API Keys, RAG, Workspaces)
HABILITAR_FASE2=false
